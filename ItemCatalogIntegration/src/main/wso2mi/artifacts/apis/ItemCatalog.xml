<?xml version="1.0" encoding="UTF-8"?>
<api context="/itemcatalog" name="ItemCatalog" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET" uri-template="/">
        <inSequence>
            <log category="INFO" logMessageID="true" logFullPayload="true" description="Request Logger">
                <message>Request Pay load Logger -------${params.queryParams.id}</message>
            </log>
            <property name="messageType" scope="axis2" type="STRING" description="Adding Content-Type" value="application/json"/>
            <property name="Accept-Encoding" scope="transport" action="remove" description="Removing Accept-Encoding from Header"/>
            <property name="query.param.id" scope="default" type="STRING" expression="${params.queryParams.id}" description="Setting the Filter Parameter"/>
            <http.get configKey="ItemCatalogEndpoint">
                <relativePath>?id=${properties.synapse.["query.param.id"]}</relativePath>
                <headers>[]</headers>
                <forceScAccepted>false</forceScAccepted>
                <disableChunking>false</disableChunking>
                <forceHttp10>false</forceHttp10>
                <noKeepAlive>false</noKeepAlive>
                <responseVariable>http_get_1</responseVariable>
                <overwriteBody>true</overwriteBody>
            </http.get>

            <log category="INFO" logMessageID="true" logFullPayload="true" description="Printing Response Payload">
                <message>Response Payload ----------- ${payload}</message>
            </log>
            <respond description="Reply"/>
        </inSequence>
        <faultSequence>
            <log category="ERROR" logMessageID="true" logFullPayload="true" description="Logging Exception">
                <message>Exception Logger -----</message>
            </log>
            <respond description="Reply"/>
        </faultSequence>
    </resource>
</api>